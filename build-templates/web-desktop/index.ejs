<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>枫野物语 · Maplewild</title>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="screen-orientation" content="landscape">
  <link rel="stylesheet" href="<%= cssUrl %>">
  <style>
    :root{--safe-top:env(safe-area-inset-top,0px);--safe-right:env(safe-area-inset-right,0px);--safe-bottom:env(safe-area-inset-bottom,0px);--safe-left:env(safe-area-inset-left,0px);--view-w:calc(100vw - var(--safe-left) - var(--safe-right));--view-h:calc(100vh - var(--safe-top) - var(--safe-bottom))}
    html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#152e2b}
    body{display:flex;align-items:center;justify-content:center;box-sizing:border-box;padding:var(--safe-top) var(--safe-right) var(--safe-bottom) var(--safe-left)}
    #GameDiv{width:min(var(--view-w),calc(var(--view-h) * 1.777777778))!important;height:min(var(--view-h),calc(var(--view-w) * 0.5625))!important;flex-shrink:0;overflow:hidden;margin:0;border:0;border-radius:0;box-shadow:none}
    #Cocos3dGameContainer,#GameCanvas{width:100%;height:100%;outline:none}
    @supports(height:100dvh){:root{--view-h:calc(100dvh - var(--safe-top) - var(--safe-bottom))}body{height:100dvh}}
  </style>
</head>
<body>
  <div id="GameDiv" cc_exact_fit_screen="false">
    <div id="Cocos3dGameContainer"><canvas id="GameCanvas" width="1280" height="720" tabindex="99"></canvas></div>
  </div>
  <%- include(cocosTemplate, {}) %>
</body>
</html>
